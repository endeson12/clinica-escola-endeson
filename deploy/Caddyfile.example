portal.example.org {
    encode zstd gzip
    request_body {
        max_size 128KB
    }
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "same-origin"
        # unsafe-inline só em CSS para compatibilidade das telas clínicas legadas.
        # Scripts inline não são permitidos; dados de usuário são tratados como texto.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
    reverse_proxy 127.0.0.1:18182
}
