# Copie para .env (NAO versionar o .env) ou configure no IntelliJ em Run > Edit Configurations > Environment variables.

# Opcao 1: banco local (JDBC)
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/clinica
DB_USERNAME=clinica
DB_PASSWORD=troque-esta-senha

# Opcao 2: banco gerenciado (Neon/Vercel) - formato postgres://usuario:senha@host/banco?sslmode=require
# DATABASE_URL=

# Usuarios de demonstracao (criados/atualizados automaticamente ao iniciar)
DEMO_ADMIN_EMAIL=admin@clinica-escola.demo
DEMO_ADMIN_PASSWORD=defina-uma-senha-forte
DEMO_RECEPCAO_EMAIL=recepcao.joquei@clinica-escola.demo
DEMO_RECEPCAO_PASSWORD=defina-outra-senha

# true somente quando a aplicacao estiver em HTTPS
COOKIE_SECURE=false
